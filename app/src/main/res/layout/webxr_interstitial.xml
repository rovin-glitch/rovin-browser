<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="showHowTo"
            type="boolean" />
        <variable
            name="showFallback"
            type="boolean" />
    </data>

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="280dp"
        android:padding="5dp"
        android:background="#000000"
        >
        <ImageView
            android:id="@+id/webxrSpinner"
            app:visibleGone="@{!showHowTo}"
            tools:visibility="gone"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_centerInParent="true"
            tools:layout_width="@dimen/webxr_interstitial_width"
            tools:layout_height="@dimen/webxr_interstitial_height"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/webxr_spinner" />

        <TextView
            tools:visibility="visible"
            app:visibleGone="@{showHowTo}"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:textAlignment="center"
            android:textSize="20sp"
            android:background="@color/black"
            android:text="@string/webxr_interstitial_how_to_continue_1"/>

        <Button
            android:id="@+id/rovinFallbackButton"
            app:visibleGone="@{showFallback}"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_below="@id/webxrSpinner"
            android:layout_marginTop="20dp"
            android:text="@string/rovin_startup_fallback_enter_game"
            android:background="#444444"
            android:textColor="#FFFFFF"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/webxrConsole"
            android:layout_width="300dp"
            android:layout_height="80dp"
            android:layout_below="@id/webxrSpinner"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="5dp"
            android:padding="6dp"
            android:background="#CC0000"
            android:textColor="#FFFFFF"
            android:text="[V135] Handshake Pending..."
            android:textSize="8sp"
            android:textStyle="bold"
            android:typeface="monospace"
            android:gravity="bottom|start"
            android:visibility="visible" />
    </RelativeLayout>

</layout>